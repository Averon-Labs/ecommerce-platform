# Admin SPA -> Laravel API origin (public value, no credentials).
# Copy to `.env.local` (git-ignored) to override. Vite only exposes VITE_* vars.
# The dev server must run on http://localhost:5173 so the backend's
# SANCTUM_STATEFUL_DOMAINS accepts the stateful session cookie.
VITE_API_BASE_URL=http://localhost:8000/api/v1
