<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.EShopVerse.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_card_pinterest</item>
    </style>
    <style name="ShapeAppearance.EShopVerse.Panel" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_bento</item>
    </style>
    <style name="ShapeAppearance.EShopVerse.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_pill</item>
    </style>
    <style name="ShapeAppearance.EShopVerse.InputPill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_search_pill</item>
    </style>

    <style name="Widget.EShopVerse.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.EShopVerse.ComponentTitle</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.EShopVerse.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/navigation_item_tint</item>
        <item name="itemTextColor">@color/navigation_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.EShopVerse.BottomNavigation.Indicator</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.EShopVerse.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/m3_primary_container</item>
    </style>

    <style name="Widget.EShopVerse.Button.Filled" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
    </style>
    <style name="Widget.EShopVerse.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
    </style>
    <style name="Widget.EShopVerse.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/surface_white</item>
        <item name="android:textColor">@color/text_primary_ink</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
    </style>
    <style name="Widget.EShopVerse.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>
    <style name="Widget.EShopVerse.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.EShopVerse.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/m3_error</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EShopVerse.InputPill</item>
    </style>
    <style name="Widget.EShopVerse.TextInputLayout.Error" parent="Widget.EShopVerse.TextInputLayout.Outlined">
        <item name="errorTextColor">?attr/colorError</item>
    </style>
    <style name="Widget.EShopVerse.TextInputLayout.HelperText" parent="Widget.EShopVerse.TextInputLayout.Outlined">
        <item name="helperTextTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.EShopVerse.DropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/m3_error</item>
    </style>

    <style name="Widget.EShopVerse.Card.Product" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.EShopVerse.Card</item>
        <item name="cardElevation">@dimen/elevation_level_1</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_hairline</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>
    <style name="Widget.EShopVerse.Card.Order" parent="Widget.EShopVerse.Card.Product" />
    <style name="Widget.EShopVerse.Card.Category" parent="Widget.EShopVerse.Card.Product" />
    <style name="Widget.EShopVerse.Card.Panel" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.EShopVerse.Panel</item>
        <item name="cardElevation">@dimen/elevation_level_1</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_hairline</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <style name="Widget.EShopVerse.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/corner_pill</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">@color/m3_on_primary_container</item>
    </style>
    <style name="Widget.EShopVerse.Badge.Status" parent="">
        <item name="android:background">@drawable/bg_status_badge</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.EShopVerse.Supporting</item>
    </style>
    <style name="Widget.EShopVerse.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceInverse</item>
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
    </style>
    <style name="Widget.EShopVerse.ProgressIndicator.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.EShopVerse.ProgressIndicator.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorPrimaryContainer</item>
    </style>
    <style name="Widget.EShopVerse.Dialog" parent="MaterialAlertDialog.Material3">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>
</resources>
