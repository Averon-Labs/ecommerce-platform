<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.EShopVerse.LargeTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.EShopVerse.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.EShopVerse.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.EShopVerse.ComponentTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/lato_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.EShopVerse.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.EShopVerse.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.EShopVerse.ActionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.EShopVerse.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/color_muted_olive</item>
    </style>
