<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background">

    <com.averonlabs.eshopverse.core.ui.view.StateContainerView
        android:id="@+id/state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xxxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <!-- Editorial Brand Header -->
                <TextView
                    android:id="@+id/tv_register_brand_subtitle"
                    style="@style/TextAppearance.EShopVerse.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="ESHOP VERSE"
                    android:textColor="@color/color_muted_olive" />

                <TextView
                    android:id="@+id/tv_register_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="@string/auth_register_title"
                    android:textAppearance="@style/TextAppearance.EShopVerse.LargeTitle"
                    android:textColor="@color/text_primary_ink" />

                <TextView
                    android:id="@+id/tv_register_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:text="Join EShop Verse for curated collections and seamless checkout."
                    android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                    android:textColor="@color/color_muted_olive" />

                <!-- Form Bento Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_register_form"
                    style="@style/Widget.EShopVerse.Card.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <!-- Name row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_first_name"
                                style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/spacing_xs"
                                android:layout_weight="1"
                                android:hint="@string/auth_label_first_name"
                                app:errorEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_first_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="textPersonName|textCapWords"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_last_name"
                                style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:layout_weight="1"
                                android:hint="@string/auth_label_last_name"
                                app:errorEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_last_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="textPersonName|textCapWords"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- Email -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_email"
                            style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:hint="@string/auth_label_email"
                            app:errorEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textEmailAddress"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_password"
                            style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:hint="@string/auth_label_password"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/color_muted_olive"
                            app:errorEnabled="true"
                            app:helperText="@string/auth_hint_password"
                            app:helperTextEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Confirm Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_confirm_password"
                            style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_lg"
                            android:hint="@string/auth_label_confirm_password"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/color_muted_olive"
                            app:errorEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_confirm_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Register Pill Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_register"
                            style="@style/Widget.EShopVerse.Button.Filled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_action_register" />

                        <!-- Subtle divider with 'or' -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/border_hairline" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/spacing_sm"
                                android:paddingEnd="@dimen/spacing_sm"
                                android:text="@string/auth_divider_or"
                                android:textAppearance="@style/TextAppearance.EShopVerse.Supporting"
                                android:textColor="@color/color_muted_olive" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/border_hairline" />
                        </LinearLayout>

                        <!-- Continue with Google 52dp Pill Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_google_sign_in"
                            style="@style/Widget.EShopVerse.Button.Google"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_action_continue_with_google"
                            app:icon="@drawable/ic_google_logo" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_bar"
                            style="@style/Widget.EShopVerse.ProgressIndicator.Circular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:indeterminate="true"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Navigate to Sign In -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_to_sign_in"
                    style="@style/Widget.EShopVerse.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_action_to_sign_in"
                    android:textColor="@color/color_botanical_green" />

            </LinearLayout>
        </ScrollView>
    </com.averonlabs.eshopverse.core.ui.view.StateContainerView>
</FrameLayout>
