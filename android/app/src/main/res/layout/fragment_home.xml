<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background"
    android:fillViewport="true"
    tools:context=".shell.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <!-- Top App Brand Header -->
        <LinearLayout
            android:id="@+id/header_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_brand_wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="@string/home_brand_wordmark"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/text_primary_ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_brand_tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_tagline"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Theme Toggle / Day-Night Mode Icon in Circular Frame -->
            <FrameLayout
                android:id="@+id/btn_profile_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_category"
                android:clickable="true"
                android:contentDescription="@string/theme_light_desc"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iv_theme_toggle_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_dark_mode"
                    app:tint="@color/color_botanical_green" />

            </FrameLayout>

        </LinearLayout>

        <!-- Pill Search Bar (MUSE Design) -->
        <LinearLayout
            android:id="@+id/bar_pill_search"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_pill_search"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/color_muted_olive" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/home_search_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/color_muted_olive" />

        </LinearLayout>

        <!-- Editorial Hero Banner (Figma MUSE Node 1:2) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hero_editorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardBackgroundColor="@color/color_hero_banner"
            app:cardCornerRadius="@dimen/corner_bento"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_hero_banner_stroke"
            app:strokeWidth="@dimen/stroke_hairline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_editorial"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tv_hero_curation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/home_hero_curation"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/color_botanical_green"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:letterSpacing="-0.01"
                    android:text="@string/home_hero_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/color_ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hero_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/home_hero_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/color_muted_olive" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hero_cta"
                    style="@style/Widget.EShopVerse.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:backgroundTint="@color/color_botanical_green"
                    android:letterSpacing="0.05"
                    android:text="@string/home_hero_cta"
                    android:textColor="?attr/colorOnPrimary"
                    app:cornerRadius="@dimen/corner_pill" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Circular Category Mood Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/spacing_md"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Category: All -->
                <LinearLayout
                    android:id="@+id/chip_cat_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circular_category">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_all"
                            app:tint="@color/color_botanical_green" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/home_category_all"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_primary_ink" />

                </LinearLayout>

                <!-- Category: Home -->
                <LinearLayout
                    android:id="@+id/chip_cat_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circular_category">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home"
                            app:tint="@color/color_botanical_green" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/home_category_home"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_primary_ink" />

                </LinearLayout>

                <!-- Category: Fashion -->
                <LinearLayout
                    android:id="@+id/chip_cat_fashion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circular_category">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_fashion"
                            app:tint="@color/color_botanical_green" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/home_category_fashion"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_primary_ink" />

                </LinearLayout>

                <!-- Category: Objects -->
                <LinearLayout
                    android:id="@+id/chip_cat_objects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circular_category">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_objects"
                            app:tint="@color/color_botanical_green" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/home_category_objects"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_primary_ink" />

                </LinearLayout>

                <!-- Category: Beauty -->
                <LinearLayout
                    android:id="@+id/chip_cat_beauty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circular_category">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_beauty"
                            app:tint="@color/color_botanical_green" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/home_category_beauty"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_primary_ink" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Section Header: Trending This Week -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md">

            <TextView
                android:id="@+id/tv_trending_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_trending_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/text_primary_ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_trending_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_xs"
                android:text="@string/home_view_all"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/color_botanical_green"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Staggered Pinterest Product Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_trending_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:itemCount="4"
            tools:listitem="@layout/item_product_card" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
