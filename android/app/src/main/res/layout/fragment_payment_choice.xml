<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_payment_choice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Title -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkout_payment_title"
            android:textAppearance="@style/TextAppearance.EShopVerse.PageTitle"
            android:textColor="@color/text_primary_ink" />

        <!-- Simulation Notice Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EShopVerse.Card.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardBackgroundColor="@color/m3_primary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_simulated_payment"
                    app:tint="@color/m3_on_primary_container" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/checkout_payment_disclaimer"
                    android:textAppearance="@style/TextAppearance.EShopVerse.Supporting"
                    android:textColor="@color/m3_on_primary_container" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Amount Due Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EShopVerse.Card.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_payment_amount_due"
                    android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                    android:textColor="@color/text_secondary" />

                <com.averonlabs.eshopverse.core.ui.view.PriceTextView
                    android:id="@+id/tv_payment_amount_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.EShopVerse.LargeTitle"
                    tools:text="$94.99" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Loading Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_payment"
            style="@style/Widget.EShopVerse.ProgressIndicator.Linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Simulate Success Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_simulate_success"
            style="@style/Widget.EShopVerse.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="@string/checkout_action_simulate_success" />

        <!-- Simulate Failure Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_simulate_failure"
            style="@style/Widget.EShopVerse.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/checkout_action_simulate_failure" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
