<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_skeleton_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background"
    android:clipToPadding="false"
    android:paddingBottom="130dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Skeleton Image Bento Card (1:1 Hero Image with Shimmer Gradient) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardCornerRadius="@dimen/corner_bento"
                app:cardElevation="0dp"
                app:strokeColor="@color/m3_outline_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_color">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_placeholder_shimmer" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Skeleton Product Metadata Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md">

            <!-- Category Pill -->
            <View
                android:layout_width="80dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_shimmer_bar" />

            <!-- Title Line -->
            <View
                android:layout_width="230dp"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_shimmer_bar" />

            <!-- Price Bar -->
            <View
                android:layout_width="110dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_bar" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@color/border_hairline" />

            <!-- Description Header -->
            <View
                android:layout_width="100dp"
                android:layout_height="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_shimmer_bar" />

            <!-- Description Line 1 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_shimmer_bar" />

            <!-- Description Line 2 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_shimmer_bar" />

            <!-- Description Line 3 -->
            <View
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_shimmer_bar" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
