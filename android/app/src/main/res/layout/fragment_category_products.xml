<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_background">

    <!-- Category Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_category_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EShopVerse.ComponentTitle"
                android:textColor="@color/text_primary_ink"
                tools:text="Footwear" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_category_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.EShopVerse.Supporting"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:text="Shoes, boots, and athletic footwear"
                tools:visibility="visible" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sort"
            style="@style/Widget.EShopVerse.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:backgroundTint="@color/surface_white"
            android:contentDescription="@string/catalog_cd_sort_button"
            app:cornerRadius="@dimen/corner_pill"
            app:icon="@drawable/ic_sort"
            app:iconTint="@color/color_botanical_green"
            app:strokeColor="@color/border_hairline"
            app:strokeWidth="@dimen/stroke_hairline" />

    </LinearLayout>

    <!-- Products Content & State Container -->
    <com.averonlabs.eshopverse.core.ui.view.StateContainerView
        android:id="@+id/state_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_products"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_md_sm"
            android:paddingEnd="@dimen/spacing_md_sm"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="100dp"
            tools:listitem="@layout/item_product_card" />

    </com.averonlabs.eshopverse.core.ui.view.StateContainerView>

</LinearLayout>
