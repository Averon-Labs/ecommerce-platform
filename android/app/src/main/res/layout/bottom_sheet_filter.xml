<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_bottom_sheet_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Drag Handle Indicator -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/filter_cd_drag_handle" />

        <!-- Header: Title and Clear All Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/tv_filter_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_title"
                android:textAppearance="@style/TextAppearance.EShopVerse.SectionTitle"
                android:textColor="@color/text_primary_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_all"
                style="@style/Widget.EShopVerse.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_clear"
                android:textColor="@color/color_muted_olive" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_hairline"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Section 1: Sort Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_sort_section"
            android:textAppearance="@style/TextAppearance.EShopVerse.ComponentTitle"
            android:textColor="@color/text_primary_ink"
            android:textStyle="bold"
            android:paddingBottom="@dimen/spacing_xs" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:paddingBottom="@dimen/spacing_md">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_newest"
                style="@style/Widget.EShopVerse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_sort_newest" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_price_asc"
                style="@style/Widget.EShopVerse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_sort_price_asc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_price_desc"
                style="@style/Widget.EShopVerse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_sort_price_desc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_name_asc"
                style="@style/Widget.EShopVerse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_sort_name_asc" />

        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_hairline"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Section 2: Price Range -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_price_section"
                android:textAppearance="@style/TextAppearance.EShopVerse.ComponentTitle"
                android:textColor="@color/text_primary_ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_price_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                android:textColor="@color/color_botanical_green"
                android:textStyle="bold"
                tools:text="$0 — $200" />

        </LinearLayout>

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/slider_price_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="200.0"
            android:stepSize="5.0"
            app:thumbColor="@color/color_botanical_green"
            app:trackColorActive="@color/color_botanical_green"
            app:trackColorInactive="@color/color_soft_sage"
            android:layout_marginBottom="@dimen/spacing_md" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_hairline"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Section 3: Availability (In Stock Only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_in_stock_only"
                    android:textAppearance="@style/TextAppearance.EShopVerse.ComponentTitle"
                    android:textColor="@color/text_primary_ink"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_in_stock_desc"
                    android:textAppearance="@style/TextAppearance.EShopVerse.Supporting"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_in_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Apply Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_filter"
            style="@style/Widget.EShopVerse.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/filter_action_apply"
            app:cornerRadius="@dimen/corner_pill" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
