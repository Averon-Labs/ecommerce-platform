<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background">

    <com.averonlabs.eshopverse.core.ui.view.StateContainerView
        android:id="@+id/state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xxxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <!-- Editorial Brand Header -->
                <TextView
                    android:id="@+id/tv_request_reset_brand_subtitle"
                    style="@style/TextAppearance.EShopVerse.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="ESHOP VERSE"
                    android:textColor="@color/color_muted_olive" />

                <TextView
                    android:id="@+id/tv_request_reset_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="@string/auth_request_reset_title"
                    android:textAppearance="@style/TextAppearance.EShopVerse.LargeTitle"
                    android:textColor="@color/text_primary_ink" />

                <TextView
                    android:id="@+id/tv_request_reset_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:text="Enter your email to receive password reset instructions."
                    android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                    android:textColor="@color/color_muted_olive" />

                <!-- Confirmation Bento Card shown on 202 Success -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_confirmation"
                    style="@style/Widget.EShopVerse.Card.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:id="@+id/tv_confirmation_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:text="@string/auth_feedback_reset_requested"
                            android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                            android:textColor="@color/text_primary_ink" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_enter_token"
                            style="@style/Widget.EShopVerse.Button.Filled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_action_set_password" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Request Form Layout -->
                <LinearLayout
                    android:id="@+id/layout_request_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_reset_form"
                        style="@style/Widget.EShopVerse.Card.Panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_email"
                                style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_lg"
                                android:hint="@string/auth_label_email"
                                app:errorEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_email"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionDone"
                                    android:inputType="textEmailAddress"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_send_reset"
                                style="@style/Widget.EShopVerse.Button.Filled"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/auth_action_send_reset" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_bar"
                                style="@style/Widget.EShopVerse.ProgressIndicator.Circular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:indeterminate="true"
                                android:visibility="gone" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_to_sign_in"
                        style="@style/Widget.EShopVerse.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_action_to_sign_in"
                        android:textColor="@color/color_botanical_green" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.averonlabs.eshopverse.core.ui.view.StateContainerView>
</FrameLayout>
