<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background">

    <com.averonlabs.eshopverse.core.ui.view.StateContainerView
        android:id="@+id/state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xxxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <!-- Editorial Brand Header -->
                <TextView
                    android:id="@+id/tv_set_password_brand_subtitle"
                    style="@style/TextAppearance.EShopVerse.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="ESHOP VERSE"
                    android:textColor="@color/color_muted_olive" />

                <TextView
                    android:id="@+id/tv_set_password_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="@string/auth_set_new_password_title"
                    android:textAppearance="@style/TextAppearance.EShopVerse.LargeTitle"
                    android:textColor="@color/text_primary_ink" />

                <TextView
                    android:id="@+id/tv_set_password_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:text="Enter your reset token and choose a new secure password."
                    android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                    android:textColor="@color/color_muted_olive" />

                <!-- Invalid / Expired Token Recovery Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_invalid_token"
                    style="@style/Widget.EShopVerse.Card.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:id="@+id/tv_invalid_token_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:text="@string/auth_error_reset_token_invalid_state"
                            android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                            android:textColor="@color/status_error" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_back_to_request_reset"
                            style="@style/Widget.EShopVerse.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_action_back_to_reset" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Success State Bento Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_success"
                    style="@style/Widget.EShopVerse.Card.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:id="@+id/tv_success_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:text="@string/auth_feedback_password_changed"
                            android:textAppearance="@style/TextAppearance.EShopVerse.Body"
                            android:textColor="@color/status_success" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_go_to_sign_in"
                            style="@style/Widget.EShopVerse.Button.Filled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_action_sign_in" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Set Password Form Layout -->
                <LinearLayout
                    android:id="@+id/layout_set_password_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_password_form"
                        style="@style/Widget.EShopVerse.Card.Panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_reset_token"
                                style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_sm"
                                android:hint="@string/auth_label_reset_token"
                                app:errorEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_reset_token"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="text"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_password"
                                style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_sm"
                                android:hint="@string/auth_label_password"
                                app:endIconMode="password_toggle"
                                app:endIconTint="@color/color_muted_olive"
                                app:errorEnabled="true"
                                app:helperText="@string/auth_hint_password"
                                app:helperTextEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_password"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="textPassword"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_confirm_password"
                                style="@style/Widget.EShopVerse.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_lg"
                                android:hint="@string/auth_label_confirm_password"
                                app:endIconMode="password_toggle"
                                app:endIconTint="@color/color_muted_olive"
                                app:errorEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_confirm_password"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionDone"
                                    android:inputType="textPassword"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_submit_new_password"
                                style="@style/Widget.EShopVerse.Button.Filled"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/auth_action_set_password" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_bar"
                                style="@style/Widget.EShopVerse.ProgressIndicator.Circular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:indeterminate="true"
                                android:visibility="gone" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.averonlabs.eshopverse.core.ui.view.StateContainerView>
</FrameLayout>
