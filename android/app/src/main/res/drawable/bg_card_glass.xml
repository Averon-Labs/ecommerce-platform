<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent luminous tint for Glassmorphism -->
    <solid android:color="@color/glass_white_15" />
    
    <!-- 1dp hairline border creates the crisp physical glass reflection -->
    <stroke
        android:width="1dp"
        android:color="@color/glass_white_30" />
        
    <corners android:radius="@dimen/corner_lg" />
</shape>
