<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.averonlabs.eshopverse.shell.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_exploreFragment"
            app:destination="@id/exploreFragment" />
        <action
            android:id="@+id/action_homeFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_categoryProductsFragment"
            app:destination="@id/categoryProductsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.averonlabs.eshopverse.shell.ExploreFragment"
        android:label="@string/explore_title"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/action_exploreFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_categoryProductsFragment"
            app:destination="@id/categoryProductsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.averonlabs.eshopverse.shell.CartFragment"
        android:label="@string/cart_title"
        tools:layout="@layout/fragment_cart" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.averonlabs.eshopverse.shell.AccountFragment"
        android:label="@string/account_title"
        tools:layout="@layout/fragment_account" />

    <include app:graph="@navigation/nav_catalog" />
    <include app:graph="@navigation/nav_auth" />
    <include app:graph="@navigation/nav_cart" />
    <include app:graph="@navigation/nav_checkout" />
    <include app:graph="@navigation/nav_orders" />

</navigation>
