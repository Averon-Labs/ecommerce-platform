<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.averonlabs.eshopverse.shell.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_exploreFragment"
            app:destination="@id/exploreFragment" />
        <action
            android:id="@+id/action_homeFragment_to_productDetailFragment"
            app:destination="@id/nav_catalog" />
        <action
            android:id="@+id/action_homeFragment_to_categoryProductsFragment"
            app:destination="@id/categoryProductsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.averonlabs.eshopverse.shell.ExploreFragment"
        android:label="@string/explore_title"
        tools:layout="@layout/fragment_explore">
        <argument
            android:name="categoryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="categoryName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_exploreFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_productDetailFragment"
            app:destination="@id/nav_catalog" />
        <action
            android:id="@+id/action_exploreFragment_to_categoryProductsFragment"
            app:destination="@id/categoryProductsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.averonlabs.eshopverse.shell.CartFragment"
        android:label="@string/cart_title"
        tools:layout="@layout/fragment_cart" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.averonlabs.eshopverse.shell.AccountFragment"
        android:label="@string/account_title"
        tools:layout="@layout/fragment_account">
        <action
            android:id="@+id/action_accountFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_accountFragment_to_requestPasswordResetFragment"
            app:destination="@id/requestPasswordResetFragment" />
        <action
            android:id="@+id/action_accountFragment_to_productDetailFragment"
            app:destination="@id/nav_catalog" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.averonlabs.eshopverse.auth.RegisterFragment"
        android:label="@string/auth_register_title"
        tools:layout="@layout/fragment_register">
        <argument
            android:name="returnToNavId"
            android:defaultValue="@id/accountFragment"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/requestPasswordResetFragment"
        android:name="com.averonlabs.eshopverse.auth.RequestPasswordResetFragment"
        android:label="@string/auth_request_reset_title"
        tools:layout="@layout/fragment_request_password_reset">
        <action
            android:id="@+id/action_requestPasswordResetFragment_to_setNewPasswordFragment"
            app:destination="@id/setNewPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/setNewPasswordFragment"
        android:name="com.averonlabs.eshopverse.auth.SetNewPasswordFragment"
        android:label="@string/auth_set_new_password_title"
        tools:layout="@layout/fragment_set_new_password">
        <action
            android:id="@+id/action_setNewPasswordFragment_to_requestPasswordResetFragment"
            app:destination="@id/requestPasswordResetFragment"
            app:popUpTo="@id/requestPasswordResetFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_setNewPasswordFragment_to_signInFragment"
            app:destination="@id/accountFragment"
            app:popUpTo="@id/accountFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <include app:graph="@navigation/nav_catalog" />
    <include app:graph="@navigation/nav_auth" />
    <include app:graph="@navigation/nav_cart" />
    <include app:graph="@navigation/nav_checkout" />
    <include app:graph="@navigation/nav_orders" />

</navigation>
