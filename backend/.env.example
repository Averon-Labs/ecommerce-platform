APP_NAME="EShop Verse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Optional hosted demo (docs/DEPLOYMENT.md): use APP_ENV=production,
# APP_DEBUG=false, the public HTTPS APP_URL, SESSION_SECURE_COOKIE=true, and
# the public host in SANCTUM_STATEFUL_DOMAINS / CORS_ALLOWED_ORIGINS. Keep the
# real DB credentials and APP_KEY only in the git-ignored .env on the host.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# First release uses a hosted MySQL server (no local database).
# Create two databases on that server: a development one and a separate,
# disposable test one. Real values live in .env only, which is git-ignored.
DB_CONNECTION=mysql
DB_HOST=mysql.example-host.com
DB_PORT=3306
DB_DATABASE=eshopverse_dev
DB_USERNAME=eshopverse_user
DB_PASSWORD=
# Encrypt the database connection (docs/SECURITY.md requires TLS).
# Download the CA certificate from your MySQL provider's console and point at it.
# `DB_SSL_CA` is accepted as an alias for `MYSQL_ATTR_SSL_CA`; either name
# enables certificate verification.
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem
# DB_SSL_CA=/path/to/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# AUTH-003: session cookie of the admin SPA (contract securitySchemes
# adminSession). HttpOnly always; Secure must be false on local HTTP and
# true behind HTTPS (docs/openapi.yaml — Secure outside local HTTP).
SESSION_COOKIE=eshop_admin_session
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Maximum Sanctum bearer-token lifetime in minutes (docs/SECURITY.md: 30 days).
SANCTUM_TOKEN_EXPIRATION=43200

# AUTH-004/AUTH-B01: Google Sign-In. Set GOOGLE_CLIENT_ID to the Web
# application OAuth client ID whose `aud` claim the API accepts for
# POST /auth/google (Google Cloud Console → APIs & Services → Credentials).
# The value must match the client the Android app requests its ID token for.
# Do not use an Android/iOS OAuth client ID here: those are not the token
# audience. The app passes the Web client ID as its server client ID.
# Not a secret: an ID token is verified against Google's public keys. When
# empty, the endpoint fails closed with 500 INTERNAL_ERROR, logs an explicit
# "GOOGLE_CLIENT_ID is not configured" error, and creates no account.
GOOGLE_CLIENT_ID=

# AUTH-B03: optional additional trusted Google OAuth client IDs (for example
# the admin web panel or an iOS build), comma-separated. A token is accepted
# when its `aud` claim matches GOOGLE_CLIENT_ID or any ID listed here.
GOOGLE_CLIENT_IDS=

# AUTH-003: first-party origins that may use cookie (stateful) sessions —
# the admin SPA dev servers and the API itself. Requests from any other
# origin stay stateless (bearer tokens only) and skip CSRF handling.
# Hosted same-origin demo: set only the public host, without a scheme
# (for example SANCTUM_STATEFUL_DOMAINS=eshopverse.byethost8.com).
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173,localhost:5174,127.0.0.1:5174,localhost:8000,127.0.0.1:8000

# AUTH-003/CAT-004: comma-separated first-party origins allowed to make
# credentialed (session-cookie) requests to the API. Local defaults cover
# the Vite admin SPA; set the deployed admin origin in real environments.
# Hosted same-origin demo: CORS_ALLOWED_ORIGINS=https://eshopverse.byethost8.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AUTH-003: password of the demo administrator created by
# AdminUserSeeder (demo-admin@eshopverse.test). Local/demo-only: put a
# private value in .env (git-ignored) — never commit a real one. When
# empty, the seeder generates a random password for that install.
DEMO_ADMIN_PASSWORD=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
